+    int v = g_reclaim_on.load(std::memory_order_relaxed);
+    if (v < 0) {
+        const char *e = getenv("OSV_FORK_ARENA_RECLAIM");
+        v = (e && e[0] == '0') ? 0 : 1;
+        g_reclaim_on.store(v, std::memory_order_relaxed);
+    }
+    return v != 0;
