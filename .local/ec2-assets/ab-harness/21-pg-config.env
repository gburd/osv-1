# 21-pg-config.env -- SINGLE SOURCE OF TRUTH for the matched PG config (A==B).
# TCG-appropriate sizing (shared_buffers scaled down; 8GB took >160s to zero under
# software emulation). Identical on BOTH OSv and Linux; hugepages OFF (later axis).
ZFS_SYNC=standard
PGARGS="-c listen_addresses=* -c port=5432 -c unix_socket_directories="
PGARGS="$PGARGS -c shared_buffers=1GB -c effective_cache_size=4GB -c work_mem=16MB"
PGARGS="$PGARGS -c maintenance_work_mem=256MB -c max_connections=256"
PGARGS="$PGARGS -c max_wal_size=8GB -c min_wal_size=2GB -c checkpoint_timeout=15min"
PGARGS="$PGARGS -c checkpoint_completion_target=0.9 -c synchronous_commit=on"
PGARGS="$PGARGS -c huge_pages=off"
PGARGS="$PGARGS -c max_parallel_workers=8 -c max_parallel_workers_per_gather=2 -c max_worker_processes=16"
PGARGS="$PGARGS -c random_page_cost=1.1 -c autovacuum=on"
PGARGS="$PGARGS -c shared_preload_libraries=plpgsql"
export PGARGS ZFS_SYNC
