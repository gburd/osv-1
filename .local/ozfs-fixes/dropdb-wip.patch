index d1dc03e07..8c8898cc4 100644
--- a/libc/signal.cc
+++ b/libc/signal.cc
@@ -549,6 +549,30 @@ int kill(pid_t pid, int sig)
             errno = ESRCH;
             return -1;
         }
+    } else if (pid == getpid()) {
+        // SELF-signal from a fork child: kill(getpid(), sig).  PostgreSQL's
+        // EmitProcSignalBarrier() sends SIGUSR1 to EVERY backend slot INCLUDING
+        // its own, then WaitForProcSignalBarrier() blocks until every slot
+        // (its own included) advances pss_barrierGeneration.  A backend bumps
+        // its OWN generation only from ProcessProcSignalBarrier(), which runs
+        // from CHECK_FOR_INTERRUPTS() when ProcSignalBarrierPending is set --
+        // and that flag is set by the SIGUSR1 handler
+        // (HandleProcSignalBarrierInterrupt).  ProcSignalBarrierPending /
+        // InterruptPending are process-global `volatile sig_atomic_t`, i.e. the
+        // backend's COW-private copy in ITS OWN address space.  If we run the
+        // handler in AS0 (the fall-through below), it sets those flags in AS0's
+        // copy, the emitting backend never sees ProcSignalBarrierPending, never
+        // absorbs its own barrier, and WaitForProcSignalBarrier waits for its
+        // own PID forever ("still waiting for backend with PID N ...", N=self)
+        // -- exactly the DROP DATABASE / DROP TABLESPACE wedge.  So a
+        // self-signal must run the handler in the CALLER's OWN address space.
+        // current_address_space() is AS0 for the top-level app/kernel
+        // (getpid()==OSV_PID) -- unchanged there and for the non-fork path.
+        target_as = mmu::current_address_space();
+        if (target_as == mmu::kernel_address_space()) {
+            target_as = nullptr;  // top-level app / kernel: AS0, as before
+        }
+        debugf("[SELFSIG] pid=%d sig=%d as0=%d\n", (int)pid, sig, target_as==nullptr);
     }
 #else
     // OSv only implements one process, whose pid is getpid().
