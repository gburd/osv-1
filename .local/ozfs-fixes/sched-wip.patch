diff --git a/libc/signal.cc b/libc/signal.cc
index d7a11bf12..4d415e4e5 100644
--- a/libc/signal.cc
+++ b/libc/signal.cc
@@ -603,6 +603,19 @@ int kill(pid_t pid, int sig)
             errno = ESRCH;
             return -1;
         }
+    } else if (pid == getpid()) {
+        // [K1] Self-signal from a fork child: run the handler in the CALLER's
+        // own COW address space so a self-directed handler (PostgreSQL Emit-
+        // ProcSignalBarrier -> kill(getpid(), SIGUSR1) -> HandleProcSignal-
+        // BarrierInterrupt) sets ProcSignalBarrierPending in the COPY the
+        // backend reads.  If it ran in AS0 the ack lands in AS0 and the backend
+        // waits forever (DROP DATABASE / DROP TABLESPACE hang).  A fork child
+        // has a non-kernel _current_as; AS0/kernel and the non-fork app keep
+        // nullptr (-> AS0), so that path is unchanged.
+        mmu::address_space *cur = mmu::current_address_space();
+        if (cur != mmu::kernel_address_space()) {
+            target_as = cur;
+        }
     }
 #else
     // OSv only implements one process, whose pid is getpid().
